# ==========================================================
# PRECY+ SISTEMAS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ==========================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── Stripe ────────────────────────────────────────────────
# Chave pública (frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Chave secreta (backend) — NUNCA expor no frontend
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret — gerado no painel Stripe
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — criados no painel Stripe
# Stripe Dashboard → Products → Add product → Add price
STRIPE_PRICE_ID_BASIC=price_...    # R$17/mês - Basic
STRIPE_PRICE_ID_PRO=price_...      # R$47/mês - Pro

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Precy+ Sistemas
NEXT_PUBLIC_APP_URL=https://precyplus.com.br

# ── Modo demo (não usar em produção) ──────────────────────
NEXT_PUBLIC_DEMO_MODE=false

# ── Catálogo Online: Mercado Pago (pagamento) ─────────────
# Enquanto não houver credenciais, deixe MERCADOPAGO_MODE=mock
# (ou simplesmente não defina MERCADOPAGO_ACCESS_TOKEN) — o checkout
# funciona com aprovação simulada para testes.
# MERCADOPAGO_ACCESS_TOKEN só é usado em modo mock/dev — em produção, cada
# empresa cobra na PRÓPRIA conta MP, conectada via OAuth (ver variáveis
# de Marketplace abaixo). Sem conexão própria, a cobrança falha com
# mensagem clara em vez de usar um token global.
MERCADOPAGO_MODE=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# ── Catálogo Online: Mercado Pago Marketplace (OAuth) ─────
# Modelo Marketplace: cada empresa conecta a própria conta MP em
# Catálogo > Pagamentos (app/api/mercadopago/oauth/connect|callback).
# MERCADOPAGO_APP_ID / MERCADOPAGO_CLIENT_SECRET vêm da aplicação criada em
# Mercado Pago → Suas integrações → "Precy-Plus-Marketplace" (API de Orders).
# MERCADOPAGO_WEBHOOK_SECRET acima é o mesmo usado para validar a assinatura
# dos webhooks dessa aplicação (painel do app → Webhooks → Chave secreta).
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# PAYMENTS_ENCRYPTION_KEY: chave AES-256 em hex (64 caracteres) usada para
# cifrar os tokens OAuth de cada empresa em mercadopago_connections. Gere
# com: openssl rand -hex 32 — NUNCA reaproveite entre ambientes.
PAYMENTS_ENCRYPTION_KEY=

# ── Catálogo Online: SuperFrete (frete) ───────────────────
# Mesma lógica: sem SUPERFRETE_API_KEY, usa cálculo simulado.
# CEP/endereço de origem agora ficam em Configurações → Catálogo → Entrega
# (por loja, não mais aqui). SUPERFRETE_USER_AGENT é exigido pela API da
# SuperFrete para identificar a aplicação (nome + contato técnico).
SUPERFRETE_MODE=mock
SUPERFRETE_API_KEY=
SUPERFRETE_BASE_URL=https://api.superfrete.com
SUPERFRETE_USER_AGENT=Precy+ (jessicamarianecosta@gmail.com)
# Modalidades cotadas (obrigatório pra API real — sem isso ela responde 200
# sem nenhum frete). IDs: 1=PAC, 2=SEDEX, 17=Mini Envios. Pra adicionar mais
# transportadoras (Jadlog, Loggi...), só atualizar aqui, sem novo deploy.
SUPERFRETE_SERVICES=1,2,17
# Secret gerado ao criar o Webhook App no painel SuperFrete — valida o
# header X-ME-Signature em /api/webhooks/superfrete (geração de etiqueta
# não tem modo mock: sem API key, o botão "Gerar envio" fica desabilitado).
SUPERFRETE_WEBHOOK_SECRET=
