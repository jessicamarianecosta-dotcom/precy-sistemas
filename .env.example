# ==========================================================
# PRECY+ SISTEMAS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ==========================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── Stripe ────────────────────────────────────────────────
# Chave pública (frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Chave secreta (backend) — NUNCA expor no frontend
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret — gerado no painel Stripe
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — criados no painel Stripe
# Stripe Dashboard → Products → Add product → Add price
STRIPE_PRICE_ID_BASIC=price_...    # R$17/mês - Basic
STRIPE_PRICE_ID_PRO=price_...      # R$47/mês - Pro

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Precy+ Sistemas
NEXT_PUBLIC_APP_URL=https://precyplus.com.br

# ── Modo demo (não usar em produção) ──────────────────────
NEXT_PUBLIC_DEMO_MODE=false

# ── Catálogo Online: Mercado Pago (pagamento multi-loja) ──
# Enquanto não houver credenciais, deixe MERCADOPAGO_MODE=mock (ou
# simplesmente não defina MERCADOPAGO_APP_ID/MERCADOPAGO_CLIENT_SECRET) —
# o checkout funciona com aprovação simulada para testes, sem chamar o
# Mercado Pago de verdade.
#
# Cada LOJA conecta a PRÓPRIA conta Mercado Pago via OAuth (Configurações >
# Loja online > Pagamentos) — os recebimentos caem direto na conta dela, o
# Precy nunca retém nem intermedia o dinheiro. As variáveis abaixo são só
# da APLICAÇÃO do Precy no Mercado Pago (usadas para o handshake OAuth e
# para validar a assinatura dos webhooks — não são credenciais de loja):
#
# 1. Crie uma aplicação em https://www.mercadopago.com.br/developers/panel/app
#    (tipo "Pagamentos online" com Checkout Transparente/API, modelo de
#    integração "Marketplace" habilitado).
# 2. Em "Credenciais" dessa aplicação, copie o App ID e o Client Secret.
# 3. Cadastre a redirect_uri de produção: `${NEXT_PUBLIC_APP_URL}/api/loja/pagamentos/mercadopago/callback`.
# 4. Em "Webhooks" dessa aplicação, configure a notificação para pagamentos
#    e copie a assinatura secreta (chave de validação).
MERCADOPAGO_MODE=mock
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# Criptografa os tokens OAuth de cada loja antes de gravar no banco — gere
# com `openssl rand -hex 32`. Exclusiva deste uso (nunca reaproveitar outra
# chave do projeto). Trocar essa chave invalida as contas já conectadas
# (elas precisam reconectar).
PAYMENTS_ENCRYPTION_KEY=

# ── Catálogo Online: SuperFrete (frete) ───────────────────
# Mesma lógica: sem SUPERFRETE_API_KEY, usa cálculo simulado.
# CEP/endereço de origem agora ficam em Configurações → Catálogo → Entrega
# (por loja, não mais aqui). SUPERFRETE_USER_AGENT é exigido pela API da
# SuperFrete para identificar a aplicação (nome + contato técnico).
SUPERFRETE_MODE=mock
SUPERFRETE_API_KEY=
SUPERFRETE_BASE_URL=https://api.superfrete.com
SUPERFRETE_USER_AGENT=Precy+ (jessicamarianecosta@gmail.com)
# Secret gerado ao criar o Webhook App no painel SuperFrete — valida o
# header X-ME-Signature em /api/webhooks/superfrete (geração de etiqueta
# não tem modo mock: sem API key, o botão "Gerar envio" fica desabilitado).
SUPERFRETE_WEBHOOK_SECRET=
